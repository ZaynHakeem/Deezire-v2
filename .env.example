# Leave these unset to keep the local demo (made-up passwords, this browser only).
# VITE_* values are public. Use the anon key, never the service role key.

# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional separate API. Ignored when the Supabase values above are set.
# VITE_AUTH_PROVIDER=api
# VITE_AUTH_API_URL=https://your-backend.example/api/auth
